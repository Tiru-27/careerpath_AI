# Local backend defaults. Docker Compose uses the PostgreSQL variables below.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./careerpath.db
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Required for Docker Compose / hosted PostgreSQL deployments.
POSTGRES_DB=careerpath
POSTGRES_USER=careerpath
POSTGRES_PASSWORD=replace-with-a-strong-database-password
